<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Default compact light theme -->
    <sys:Double x:Key="NavButtonSize">40</sys:Double>
    <sys:Double x:Key="AddressBarHeight">44</sys:Double>
    <sys:Double x:Key="AddressBarFontSize">14</sys:Double>
    <sys:Double x:Key="ProtectionPillHeight">36</sys:Double>
    <sys:Double x:Key="ProtectionPillMinWidth">96</sys:Double>
    <sys:Double x:Key="ProtectionPillFontSize">12</sys:Double>
    <sys:Double x:Key="ShieldBadgeSize">28</sys:Double>
    <GridLength x:Key="SidebarWidth">480</GridLength>
    <sys:Double x:Key="StatusBarFontSize">12</sys:Double>
    <sys:Double x:Key="APillHeight">38</sys:Double>
    <sys:Double x:Key="APillFontSize">13</sys:Double>

    <SolidColorBrush x:Key="WindowBackground" Color="#F0F4F8"/>
    <SolidColorBrush x:Key="TabBarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChromeIconBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ChromeButtonHoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ActiveTabBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TabBarBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="NavBarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavBarBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="AddressBarBackground" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="AddressBarFocusBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LoadingBarBackground" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LoadingBarForeground" Color="#0EA5E9"/>
    <LinearGradientBrush x:Key="ProtectionPillBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0"/>
        <GradientStop Color="#0891B2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProtectionPillForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SidebarHeaderBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScoreBannerBackground" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="ChipBackground" Color="#E8ECF0"/>
    <SolidColorBrush x:Key="ScoreRingStroke" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ScoreRingCenterBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScoreBarTrackBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ScoreBarFillBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="CardSecondaryBackground" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="ScrollbarTrack" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ScrollbarThumb" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#64748B"/>
    <SolidColorBrush x:Key="MenuPopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#E8ECF0"/>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="AccentLinkBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerButtonForeground" Color="#B91C1C"/>
    <SolidColorBrush x:Key="HighRiskWarningBackground" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="HighRiskWarningBorder" Color="#EF4444"/>
    <SolidColorBrush x:Key="HighRiskWarningText" Color="#991B1B"/>
    <SolidColorBrush x:Key="CrashOverlayBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="CrashOverlayTitle" Color="#202124"/>
    <SolidColorBrush x:Key="CrashOverlaySubtitle" Color="#5F6368"/>

    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, Arial</FontFamily>

    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="TextBodyMuted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="TextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TextSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
